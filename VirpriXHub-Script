-- WizardLib.lua (v1.6 — titlebar-only collapse)

local WizardLib = {}
WizardLib.__index = WizardLib

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local COLORS = {
    bg        = Color3.fromRGB(34, 34, 34),
    titlebar  = Color3.fromRGB(42, 42, 42),
    control   = Color3.fromRGB(58, 58, 58),
    border    = Color3.fromRGB(60, 60, 60),
    togon     = Color3.fromRGB(85, 85, 85),
    tabactive = Color3.fromRGB(55, 55, 55),
    text      = Color3.fromRGB(255, 255, 255),
    muted     = Color3.fromRGB(170, 170, 170),
    label     = Color3.fromRGB(120, 120, 120),
}

local TWEEN_OPEN  = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_CLOSE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local function makeTween(obj, props, info)
    return TweenService:Create(obj, info or TWEEN_OPEN, props)
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 5)
    c.Parent = parent
end

local function stroke(parent, color)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.border
    s.Thickness = 1
    s.Parent = parent
end

local function makeLabel(parent, text, size, color)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text           = text
    l.TextColor3     = color or COLORS.text
    l.TextSize       = size or 12
    l.Font           = Enum.Font.GothamMedium
    l.Position       = UDim2.new(0, 0, 0, 0)
    l.Size           = UDim2.new(1, 0, 1, 0)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent         = parent
    return l
end

function WizardLib.new(scriptName)
    local self = setmetatable({}, WizardLib)
    self._open          = true
    self._contentHeight = 0
    self._tabHeight     = 0
    self._locked        = false
    self._tabs          = {}
    self._activeTab     = nil

    local sg = Instance.new("ScreenGui")
    sg.Name           = "WizardLib"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.IgnoreGuiInset = true
    sg.Parent         = game:GetService("CoreGui")

    -- Wrapper: drag anchor, never clips
    local wrapper = Instance.new("Frame")
    wrapper.Name                   = "Wrapper"
    wrapper.BackgroundTransparency = 1
    wrapper.BorderSizePixel        = 0
    wrapper.Position               = UDim2.new(0, 80, 0, 80)
    wrapper.Size                   = UDim2.new(0, 220, 0, 28)
    wrapper.Parent                 = sg
    self._wrapper = wrapper

    -- Titlebar: always visible, never resizes
    local tb = Instance.new("Frame")
    tb.Name             = "Titlebar"
    tb.BackgroundColor3 = COLORS.titlebar
    tb.BorderSizePixel  = 0
    tb.Size             = UDim2.new(1, 0, 0, 28)
    tb.ZIndex           = 2
    corner(tb, 5)
    stroke(tb)
    tb.Parent      = wrapper
    self._titlebar = tb

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Text           = scriptName or "Script"
    title.TextColor3     = COLORS.text
    title.TextSize       = 12
    title.Font           = Enum.Font.GothamBold
    title.Position       = UDim2.new(0, 10, 0, 0)
    title.Size           = UDim2.new(1, -40, 1, 0)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent         = tb

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Name             = "ToggleBtn"
    toggleBtn.BackgroundColor3 = COLORS.control
    toggleBtn.BorderSizePixel  = 0
    toggleBtn.Position         = UDim2.new(1, -26, 0.5, -11)
    toggleBtn.Size             = UDim2.new(0, 22, 0, 22)
    toggleBtn.Text             = "-"
    toggleBtn.TextColor3       = COLORS.text
    toggleBtn.TextSize         = 14
    toggleBtn.Font             = Enum.Font.GothamBold
    toggleBtn.ZIndex           = 3
    corner(toggleBtn, 4)
    toggleBtn.Parent = tb
    self._toggleBtn  = toggleBtn

    -- Clip: sits at y=28, clips everything including tabs and content
    local clip = Instance.new("Frame")
    clip.Name             = "Clip"
    clip.BackgroundColor3 = COLORS.bg
    clip.BorderSizePixel  = 0
    clip.Position         = UDim2.new(0, 0, 0, 28)
    clip.Size             = UDim2.new(1, 0, 0, 0)
    clip.ClipsDescendants = true
    corner(clip, 5)
    stroke(clip)
    clip.Parent = wrapper
    self._clip  = clip

    -- Tab list lives INSIDE clip so it collapses with everything
    local tabList = Instance.new("Frame")
    tabList.Name                   = "TabList"
    tabList.BackgroundColor3       = COLORS.bg
    tabList.BorderSizePixel        = 0
    tabList.Position               = UDim2.new(0, 0, 0, 0)
    tabList.Size                   = UDim2.new(1, 0, 0, 0)
    tabList.Parent                 = clip
    self._tabList = tabList

    local tabListLayout = Instance.new("UIListLayout")
    tabListLayout.Padding             = UDim.new(0, 0)
    tabListLayout.FillDirection       = Enum.FillDirection.Vertical
    tabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabListLayout.Parent              = tabList
    self._tabListLayout = tabListLayout

    toggleBtn.MouseButton1Click:Connect(function()
        self:_collapse()
    end)

    self:_setupDrag()

    return self
end

function WizardLib:_syncWrapperSize()
    local total = 28 + (self._open and (self._tabHeight + self._contentHeight) or 0)
    self._wrapper.Size = UDim2.new(0, 220, 0, total)
end

function WizardLib:_openTab(tabData)
    for _, t in ipairs(self._tabs) do
        t.content.Visible      = false
        t.btn.BackgroundColor3 = COLORS.bg
        t.arrow.Text           = ">"
    end
    tabData.content.Visible      = true
    tabData.btn.BackgroundColor3 = COLORS.tabactive
    tabData.arrow.Text           = "-"
    self._activeTab              = tabData
    self._contentHeight          = tabData.height

    if self._open then
        self._clip.Size = UDim2.new(1, 0, 0, self._tabHeight + self._contentHeight)
        self:_syncWrapperSize()
    end
end

function WizardLib:_collapse()
    self._open   = not self._open
    local h      = self._tabHeight + self._contentHeight
    self._locked = true

    if self._open then
        self._toggleBtn.Text = "-"
        self._clip.Size      = UDim2.new(1, 0, 0, 0)
        local t = makeTween(self._clip,    { Size = UDim2.new(1, 0, 0, h) },      TWEEN_OPEN)
        makeTween(self._wrapper, { Size = UDim2.new(0, 220, 0, 28 + h) }, TWEEN_OPEN):Play()
        t:Play()
        t.Completed:Connect(function() self._locked = false end)
    else
        self._toggleBtn.Text = ">"
        local t = makeTween(self._clip,    { Size = UDim2.new(1, 0, 0, 0) },  TWEEN_CLOSE)
        makeTween(self._wrapper, { Size = UDim2.new(0, 220, 0, 28) }, TWEEN_CLOSE):Play()
        t:Play()
        t.Completed:Connect(function() self._locked = false end)
    end
end

function WizardLib:_setupDrag()
    local wrapper  = self._wrapper
    local titlebar = self._titlebar
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        wrapper.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    titlebar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = wrapper.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    titlebar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)
end

function WizardLib:Tab(tabName)
    local self_lib = self
    local TAB_H    = 28

    -- Tab button row (inside tabList, inside clip)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name             = "Tab_" .. tabName
    tabBtn.BackgroundColor3 = COLORS.bg
    tabBtn.BorderSizePixel  = 0
    tabBtn.Size             = UDim2.new(1, 0, 0, TAB_H)
    tabBtn.Text             = ""
    tabBtn.Parent           = self._tabList

    local tabLabel = Instance.new("TextLabel")
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text           = tabName
    tabLabel.TextColor3     = COLORS.text
    tabLabel.TextSize       = 11
    tabLabel.Font           = Enum.Font.GothamBold
    tabLabel.Position       = UDim2.new(0, 10, 0, 0)
    tabLabel.Size           = UDim2.new(1, -30, 1, 0)
    tabLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabLabel.Parent         = tabBtn

    local arrow = Instance.new("TextLabel")
    arrow.BackgroundTransparency = 1
    arrow.Text           = ">"
    arrow.TextColor3     = COLORS.muted
    arrow.TextSize       = 11
    arrow.Font           = Enum.Font.GothamBold
    arrow.Position       = UDim2.new(1, -20, 0, 0)
    arrow.Size           = UDim2.new(0, 16, 1, 0)
    arrow.TextXAlignment = Enum.TextXAlignment.Center
    arrow.Parent         = tabBtn

    local div = Instance.new("Frame")
    div.BackgroundColor3 = COLORS.border
    div.BorderSizePixel  = 0
    div.Position         = UDim2.new(0, 0, 1, -1)
    div.Size             = UDim2.new(1, 0, 0, 1)
    div.Parent           = tabBtn

    -- Update tab list size and clip position
    self._tabHeight = #self._tabs * TAB_H + TAB_H
    self._tabList.Size = UDim2.new(1, 0, 0, self._tabHeight)

    -- Content frame: sits below tab list inside clip
    local content = Instance.new("Frame")
    content.Name                   = "Content_" .. tabName
    content.BackgroundTransparency = 1
    content.BorderSizePixel        = 0
    content.Position               = UDim2.new(0, 0, 0, self._tabHeight)
    content.Size                   = UDim2.new(1, 0, 0, 0)
    content.Visible                = false
    content.Parent                 = self._clip

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding             = UDim.new(0, 3)
    listLayout.FillDirection       = Enum.FillDirection.Vertical
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Parent              = content

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft   = UDim.new(0, 8)
    padding.PaddingRight  = UDim.new(0, 8)
    padding.PaddingTop    = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 6)
    padding.Parent        = content

    local tabData = {
        btn     = tabBtn,
        arrow   = arrow,
        content = content,
        layout  = listLayout,
        height  = 0,
    }
    table.insert(self._tabs, tabData)

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if self_lib._locked then return end
        local h = listLayout.AbsoluteContentSize.Y + 16
        tabData.height = h
        content.Size   = UDim2.new(1, 0, 0, h)
        if self_lib._activeTab == tabData and self_lib._open then
            self_lib._contentHeight = h
            self_lib._clip.Size     = UDim2.new(1, 0, 0, self_lib._tabHeight + h)
            self_lib:_syncWrapperSize()
        end
    end)

    tabBtn.MouseButton1Click:Connect(function()
        self_lib:_openTab(tabData)
    end)

    -- Auto-open first tab
    if #self._tabs == 1 then
        self:_openTab(tabData)
    end

    -- Tab element API
    local tabAPI = {}

    local function row(h)
        local r = Instance.new("Frame")
        r.BackgroundTransparency = 1
        r.BorderSizePixel        = 0
        r.Size                   = UDim2.new(1, 0, 0, h or 24)
        r.Parent                 = content
        return r
    end

    function tabAPI:Label(text)
        local r = row(18)
        local l = makeLabel(r, text, 10, COLORS.label)
        l.Font = Enum.Font.GothamBold
        return self
    end

    function tabAPI:Text(text)
        local r = row(20)
        local l = makeLabel(r, text, 11, COLORS.muted)
        l.TextWrapped = true
        return self
    end

    function tabAPI:Divider()
        local r    = row(10)
        local line = Instance.new("Frame")
        line.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        line.BorderSizePixel  = 0
        line.Position         = UDim2.new(0, 0, 0.5, 0)
        line.Size             = UDim2.new(1, 0, 0, 1)
        line.Parent           = r
        return self
    end

    function tabAPI:Toggle(name, default, callback)
        local state = default or false
        local r     = row(24)
        makeLabel(r, name, 11, COLORS.text)

        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = state and COLORS.togon or COLORS.control
        btn.BorderSizePixel  = 0
        btn.Position         = UDim2.new(1, -34, 0.5, -8)
        btn.Size             = UDim2.new(0, 30, 0, 16)
        btn.Text             = ""
        corner(btn, 8)
        stroke(btn)
        btn.Parent = r

        local knob = Instance.new("Frame")
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel  = 0
        knob.Position         = UDim2.new(0, state and 15 or 2, 0.5, -6)
        knob.Size             = UDim2.new(0, 12, 0, 12)
        corner(knob, 6)
        knob.Parent = btn

        btn.MouseButton1Click:Connect(function()
            state = not state
            makeTween(btn,  { BackgroundColor3 = state and COLORS.togon or COLORS.control }):Play()
            makeTween(knob, { Position = UDim2.new(0, state and 15 or 2, 0.5, -6) }):Play()
            if callback then callback(state) end
        end)
        return self
    end

    function tabAPI:Slider(name, min, max, default, callback)
        local val = default or min
        local r   = row(34)

        local nameL = makeLabel(r, name, 11, COLORS.text)
        nameL.Size  = UDim2.new(0.6, 0, 0, 14)

        local valL = Instance.new("TextLabel")
        valL.BackgroundTransparency = 1
        valL.Text           = tostring(val)
        valL.TextColor3     = COLORS.muted
        valL.TextSize       = 10
        valL.Font           = Enum.Font.Gotham
        valL.Position       = UDim2.new(0.6, 0, 0, 0)
        valL.Size           = UDim2.new(0.4, 0, 0, 14)
        valL.TextXAlignment = Enum.TextXAlignment.Right
        valL.Parent         = r

        local track = Instance.new("Frame")
        track.BackgroundColor3 = COLORS.control
        track.BorderSizePixel  = 0
        track.Position         = UDim2.new(0, 0, 0, 18)
        track.Size             = UDim2.new(1, 0, 0, 4)
        corner(track, 2)
        track.Parent = r

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = Color3.fromRGB(140, 140, 140)
        fill.BorderSizePixel  = 0
        fill.Size             = UDim2.new((val - min) / (max - min), 0, 1, 0)
        corner(fill, 2)
        fill.Parent = track

        local knob = Instance.new("TextButton")
        knob.BackgroundColor3 = Color3.fromRGB(170, 170, 170)
        knob.BorderSizePixel  = 0
        knob.Text             = ""
        knob.Size             = UDim2.new(0, 14, 0, 14)
        knob.Position         = UDim2.new((val - min) / (max - min), -7, 0.5, -7)
        corner(knob, 7)
        knob.Parent = track

        local sliding = false
        local function setVal(input)
            local rel = math.clamp(
                (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val           = math.floor(min + (max - min) * rel)
            valL.Text     = tostring(val)
            fill.Size     = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -7, 0.5, -7)
            if callback then callback(val) end
        end

        knob.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then sliding = true end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then setVal(i) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then sliding = false end
        end)
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then setVal(i) end
        end)
        return self
    end

    function tabAPI:TextBox(name, placeholder, callback)
        local r = row(44)

        local nameL = makeLabel(r, name, 11, COLORS.text)
        nameL.Size  = UDim2.new(1, 0, 0, 14)

        local box = Instance.new("TextBox")
        box.BackgroundColor3  = Color3.fromRGB(42, 42, 42)
        box.BorderSizePixel   = 0
        box.PlaceholderText   = placeholder or "Enter value..."
        box.PlaceholderColor3 = Color3.fromRGB(80, 80, 80)
        box.Text              = ""
        box.TextColor3        = COLORS.text
        box.TextSize          = 11
        box.Font              = Enum.Font.Gotham
        box.Position          = UDim2.new(0, 0, 0, 18)
        box.Size              = UDim2.new(1, 0, 0, 22)
        box.ClearTextOnFocus  = false
        corner(box, 4)
        stroke(box)
        box.Parent = r

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 6)
        pad.Parent      = box

        box.FocusLost:Connect(function(enter)
            if callback then callback(box.Text, enter) end
        end)
        return self
    end

    function tabAPI:Button(name, callback)
        local r = row(26)

        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = COLORS.control
        btn.BorderSizePixel  = 0
        btn.Text             = name
        btn.TextColor3       = COLORS.text
        btn.TextSize         = 11
        btn.Font             = Enum.Font.GothamBold
        btn.Size             = UDim2.new(1, 0, 1, 0)
        corner(btn, 4)
        stroke(btn)
        btn.Parent = r

        btn.MouseButton1Click:Connect(function()
            if callback then callback() end
        end)
        return self
    end

    return tabAPI
end

return WizardLib
