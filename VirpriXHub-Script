local ProximityPromptService = game:GetService("ProximityPromptService")
local LocalPlayer      = Players.LocalPlayer

-- ─── Game Detection ────────────────────────────────────────────────────────────
local GAME_IDS = {
    RIVALS      = 17625359962,
    MM2         = 142823291,
    STEAL_EGG   = 107778070777162,
    FLICK       = 136801880565837,
    SLAP_BATTLE = 6403373529,
}

local function getGame()
    local id = game.PlaceId
    for name, gid in pairs(GAME_IDS) do
        if id == gid then return name end
    end
    return "UNKNOWN"
end

local CURRENT_GAME = getGame()

